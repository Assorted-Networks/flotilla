# Shared secret between the coordinator and every agent. Generate one with:
#   openssl rand -hex 32
CLUSTER_TOKEN=

# Keys that clients (Open WebUI, scripts, the dashboard) must send, comma separated.
# Leave empty only on a trusted network.
API_KEYS=
# The key Open WebUI uses (one of API_KEYS).
WEBUI_API_KEY=

CLUSTER_NAME=flotilla
NODE_NAME=head
COORDINATOR_PORT=8800
WEBUI_PORT=3000
# Model Open WebUI uses for chat titles, tags and follow-ups (a single model, not a team).
WEBUI_TASK_MODEL=qwen3.5:4b

# Models this machine downloads on first start (about 8.6 GB for the defaults).
# Add qwen3.5:9b (6.6 GB) on a machine with 8 GB+ of VRAM or 16 GB+ of RAM:
# the default teams use it for final answers when any machine has it.
PULL_MODELS=qwen3.5:4b,granite4.2:3b,ministral-3:3b
# Parallel requests this machine accepts (keep in line with OLLAMA_NUM_PARALLEL).
MAX_CONCURRENCY=2
# Optional labels for placement rules, e.g. gpu=nvidia,vram=12
NODE_LABELS=

OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=30m
