# Shared secret between the coordinator and every agent (openssl rand -hex 32).
CLUSTER_TOKEN=
# Keys clients must send (comma separated). Leave empty only on a trusted network.
API_KEYS=
# Key Open WebUI uses (one of API_KEYS).
WEBUI_API_KEY=
CLUSTER_NAME=flotilla
COORDINATOR_PORT=8800
WEBUI_PORT=3000
# Model Open WebUI uses for chat titles, tags and follow-ups (a single model, not a team).
WEBUI_TASK_MODEL=qwen3.5:4b
# Built-in TLS, paths inside the container (mount ./certs:/certs first):
TLS_CERT=
TLS_KEY=
# CA that signed the agents' certificates, if agents use TLS with a private CA:
CA_FILE=
