COORDINATOR_URL=http://192.168.1.10:8800
CLUSTER_TOKEN=
NODE_NAME=pi-1
ADVERTISE_URL=http://192.168.1.40:8801
AGENT_PORT=8801

# GGUF repository on Hugging Face and the model name the cluster will see.
HF_MODEL=ggml-org/gemma-3-1b-it-GGUF
SERVED_NAME=gemma-3-1b
# Total context shared by PARALLEL slots (each request gets CTX_SIZE / PARALLEL).
CTX_SIZE=16384
PARALLEL=2
# Layers to offload to a GPU (use a -cuda/-rocm/-vulkan LLAMACPP_IMAGE); 0 = CPU only.
GPU_LAYERS=0
# LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
