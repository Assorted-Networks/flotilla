COORDINATOR_URL=http://192.168.1.10:8800
CLUSTER_TOKEN=
NODE_NAME=gpu-vllm-1
ADVERTISE_URL=http://192.168.1.30:8801
AGENT_PORT=8801

# Any chat model vLLM supports (Hugging Face id) and the name it is served as.
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
SERVED_NAME=qwen3-4b-vllm
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.85
# Needed for gated models only.
HF_TOKEN=
# vLLM handles many requests at once; raise on large GPUs.
MAX_CONCURRENCY=8
NODE_LABELS=gpu=nvidia
