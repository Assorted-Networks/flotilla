# Where the coordinator runs (reachable from this machine).
COORDINATOR_URL=http://192.168.1.10:8800
# Same value as on the coordinator.
CLUSTER_TOKEN=
# Unique name for this machine.
NODE_NAME=node-1
# How the coordinator reaches this machine's agent. Use this machine's LAN
# (or Tailscale) address and AGENT_PORT.
ADVERTISE_URL=http://192.168.1.21:8801
AGENT_PORT=8801

# Models to download on first start. Pick what fits this machine:
#   8 GB RAM, no GPU ...... qwen3.5:2b,granite4.2:3b
#   16 GB RAM or 6-8 GB GPU qwen3.5:4b,granite4.2:3b,ministral-3:3b
#   12 GB+ GPU ............ add qwen3.5:9b and/or gemma4:12b (final-answer models)
PULL_MODELS=qwen3.5:4b,granite4.2:3b,ministral-3:3b
# Parallel requests this machine accepts; keep equal to OLLAMA_NUM_PARALLEL
# unless it serves several models at once.
MAX_CONCURRENCY=2
# Optional labels for placement rules, e.g. gpu=nvidia,vram=12
NODE_LABELS=

OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=30m

# Optional TLS for the agent (paths inside the container):
TLS_CERT=
TLS_KEY=
CA_FILE=
